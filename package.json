{
  "name": "@speednexus_messenger/smileed-nexus",
  "version": "1.0.2",
  "description": "Красивая, быстрая и лёгкая панель эмодзи для React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.tsx",
    "emojiData.ts",
    "emojiSkins.ts",
    "emojiSprite.ts",
    "EmojiSvg.tsx",
    "EmojiText.tsx",
    "labels.ts",
    "useRecentEmojis.ts",
    "SmileedNexus.css",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "emoji",
    "emoji-picker",
    "twemoji",
    "picker",
    "svg"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:data": "node scripts/gen-data.mjs",
    "gen:sprite": "node scripts/gen-sprite.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "emojibase-data": "^18.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^3.3.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}